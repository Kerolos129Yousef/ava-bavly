generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  photo     String?
  role      String   // SERVANT, CLASS_ADMIN, CLASS_ASSISTANT, MINISTRY_ADMIN
  suspended Boolean  @default(false)
  servantId String?
  servant   Servant? @relation(fields: [servantId], references: [id])
  classId        String?
  class          Class?         @relation(fields: [classId], references: [id])
  notifications         Notification[]
  lastSeenNotifications DateTime?
  createdAt             DateTime       @default(now())
}

model Person {
  id              String   @id @default(cuid())
  name            String
  photo           String?
  birthDate       DateTime?
  gender          String?
  phone           String?
  guardianName    String?
  guardianPhone   String?
  address         String?
  disabilityType  String?
  disabilityCause String?
  classId         String?
  class           Class?   @relation(fields: [classId], references: [id])
  notes           String?

  // Medical
  medications     String?
  allergies       String?
  medicalHistory  String?
  doctorName      String?
  doctorPhone     String?

  // Skills assessment (1-5 scale)
  cognitiveSkills     String?
  physicalSkills      String?
  socialSkills        String?
  communicationSkills String?
  selfCareSkills      String?
  dailyLivingNote     String?

  // Servant
  servantId       String?
  servant         Servant? @relation(fields: [servantId], references: [id])

  behaviorNotes     BehaviorNote[]
  aiRecommendations AIRecommendation[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Servant {
  id            String   @id @default(cuid())
  name          String
  phone         String?
  email         String?
  photo         String?
  address       String?
  education     String?
  maritalStatus String?
  job           String?
  classId       String?
  class         Class?   @relation(fields: [classId], references: [id])
  persons       Person[]
  users         User[]
}

model Class {
  id            String         @id @default(cuid())
  name          String         @unique
  type          String
  persons       Person[]
  users         User[]
  servants      Servant[]
  notifications Notification[]
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  body      String
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  classId   String?
  class     Class?   @relation(fields: [classId], references: [id])
  createdAt DateTime @default(now())
}

model PushSubscription {
  id        String @id @default(cuid())
  userId    String
  endpoint  String @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model BehaviorNote {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  note      String
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

model AIRecommendation {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
}
