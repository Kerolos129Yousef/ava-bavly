generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Person {
  id              String   @id @default(cuid())
  name            String
  birthDate       DateTime?
  gender          String?
  phone           String?
  guardianName    String?
  guardianPhone   String?
  address         String?
  disabilityType  String?
  disabilityCause String?
  classId         String?
  class           Class?   @relation(fields: [classId], references: [id])
  notes           String?

  // Medical
  medications     String?
  allergies       String?
  medicalHistory  String?
  doctorName      String?
  doctorPhone     String?

  // Skills assessment (1-5 scale, stored as JSON)
  cognitiveSkills  String?
  physicalSkills   String?
  socialSkills     String?
  communicationSkills String?
  selfCareSkills   String?
  dailyLivingNote  String?

  // Servant
  servantId       String?
  servant         Servant? @relation(fields: [servantId], references: [id])

  behaviorNotes   BehaviorNote[]
  aiRecommendations AIRecommendation[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Servant {
  id       String   @id @default(cuid())
  name     String
  phone    String?
  email    String?
  persons  Person[]
}

model Class {
  id       String   @id @default(cuid())
  name     String   @unique
  type     String
  persons  Person[]
}

model BehaviorNote {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  note      String
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

model AIRecommendation {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
}
